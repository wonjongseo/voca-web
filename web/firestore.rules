rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isGroupMember(groupId) {
      return signedIn() &&
        get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids[request.auth.uid] == true;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /words/{wordId} {
        allow read, write: if isOwner(uid);
      }

      match /reviews/{reviewId} {
        allow read, write: if isOwner(uid);
      }

      match /groups/{groupId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /groups/{groupId} {
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.memberUids[request.auth.uid] == true;
      allow read: if isGroupMember(groupId);
      allow update: if isGroupMember(groupId) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        (request.auth.uid == resource.data.ownerUid ||
         !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['memberUids', 'memberEmails']));
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /words/{wordId} {
        allow read, write: if isGroupMember(groupId);
      }

      match /reviews/{reviewId} {
        allow read, write: if isGroupMember(groupId);
      }
    }
  }
}
